# Required: Prisma database
DATABASE_URL=""
# Required: OAuth providers configured in lib/auth.ts
AUTH_SECRET=""
GITHUB_ID=""
GITHUB_SECRET=""
GOOGLE_ID=""
GOOGLE_SECRET=""

# Optional: required only if you use image uploads via Cloudinary
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Optional: required only if you want realtime chat delivery via Ably
ABLY_API_KEY=""

# Required if you want chat messages stored encrypted in the database
# Generate a 32-byte base64 key, for example with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MESSAGE_ENCRYPTION_KEY=""
